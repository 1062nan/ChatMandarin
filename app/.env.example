# =====================================================
# ChatMandarin 环境变量配置
# =====================================================
# 复制本文件为 .env.local，填入真实值。

# === Supabase（数据库 + 认证） ===
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xobfnmwaxlswfofmembv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=你的anon_key
# Service Role Key: 服务端专用（绕过 RLS，永不暴露到前端）
SUPABASE_SERVICE_ROLE_KEY=你的service_role_key

# === DeepSeek（LLM 大语言模型） ===
# 注册: https://platform.deepseek.com → API Keys → Create Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# === 火山引擎语音（ASR + TTS） ===
# API Key: 控制台 → API Key 管理 → 创建
# 文档: https://www.volcengine.com/docs/6561/1354867
VOLCENGINE_API_KEY=
# App ID: 控制台 → 语音技术 → 应用管理
VOLCENGINE_APP_ID=

# ASR WebSocket 大模型 endpoint（固定值，一般不改）
VOLCENGINE_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
# ASR Resource ID（大模型2.0 = volc.seedasr.sauc.duration，大模型1.0 = volc.bigasr.sauc.duration）
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# ASR 录音文件识别 cluster（HSKK 模考用，需开通「录音文件识别」）
VOLCENGINE_ASR_FILE_CLUSTER=volcengine_bigasr
# TTS cluster（开通「语音合成」后填入）
VOLCENGINE_TTS_CLUSTER=volcano_tts

# === Voice gateway routing ===
# direct: current server connects to Volcengine directly
# cloudflare: Tokyo-placed Cloudflare Voice Worker (recommended)
# tokyo: compatible gateway hosted on the existing Tokyo EC2 instance
VOLCENGINE_ROUTE=cloudflare
CLOUDFLARE_VOICE_GATEWAY_URL=https://chatmandarin-voice.<your-subdomain>.workers.dev
TOKYO_VOICE_GATEWAY_URL=
# Generate a long random value and configure the same secret on the app and gateway.
VOICE_GATEWAY_SECRET=

# === Creem（支付 / Merchant of Record） ===
# 注册: https://creem.io
CREEM_API_KEY=你的api_key
# Developers → Webhooks；URL: https://app.chatmandarin.cc/api/creem/webhook
CREEM_WEBHOOK_SECRET=你的webhook_secret
# Products → Copy ID
CREEM_PLUS_PRODUCT_ID=你的plus_product_id
CREEM_PRO_PRODUCT_ID=你的pro_product_id
# 测试环境 true；正式环境 false
CREEM_TEST_MODE=true

# === App ===
# 开发: http://localhost:3000 / 生产: https://app.chatmandarin.cc
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Keep new checkout disabled until sandbox lifecycle + entitlement review pass.
# This does not disable existing subscription access/cancellation/webhooks.
CREEM_CHECKOUT_ENABLED=false
