{
  "name": "chatmandarin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime false cloudflare-env.d.ts",
    "voice:typegen": "wrangler types --config workers/voice-gateway/wrangler.jsonc --env-file .env.example --env-interface VoiceGatewayEnv --include-runtime false workers/voice-gateway/worker-configuration.d.ts",
    "voice:type-check": "tsc --project workers/voice-gateway/tsconfig.json",
    "voice:dry-run": "wrangler deploy --config workers/voice-gateway/wrangler.jsonc --dry-run",
    "voice:test": "node scripts/test-voice-gateway.mjs --duration-seconds 120",
    "voice:test:local": "node scripts/run-local-voice-test.mjs --duration-seconds 120",
    "voice:configure:production": "node scripts/configure-production-voice.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.62.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.21.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@cloudflare/workers-types": "5.20260718.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.20",
    "postcss": "^8.4.49",
    "supabase": "^2.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.19"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
